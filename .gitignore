# Datasets and raw media
# Raw videos, archives, and extracted data must never be committed.
ASL_training/data/*
!ASL_training/data/.gitkeep
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Run outputs, checkpoints, optimizer states
ASL_training/outputs/*
!ASL_training/outputs/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Generated artifacts.
# Whether one may be committed depends on the source dataset license and on
# what it actually contains. See docs/DATA_CONTRACT.md.
#
# Manifests stay out: they carry one row per video with source-relative paths
# and participant identifiers. They also regenerate deterministically from the
# dataset, and their recorded identity proves a regenerated copy matches, so
# committing them buys nothing.
ASL_training/artifacts/manifests/*
ASL_training/artifacts/reports/*
!ASL_training/artifacts/**/.gitkeep

# Label maps and audit reports are committed deliberately. Both are small,
# contain aggregate statistics and the gloss vocabulary rather than per-video
# records, and are the evidence that a checkpoint's class IDs mean what a
# report claims they mean.
ASL_training/artifacts/label_maps/*
ASL_training/artifacts/audits/*
!ASL_training/artifacts/label_maps/asl_citizen.json
!ASL_training/artifacts/audits/asl_citizen_audit.json

# Caches
.cache/
*_cache/
frame_cache/
decoded/

# Credentials and secrets
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
credentials.json
service_account*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing and tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Notebooks
# Outputs are stripped before commit; checkpoints written by notebooks are ignored above.
.ipynb_checkpoints/
notebooks/**/outputs/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Weights & Biases / logging, if adopted later
wandb/
runs/
lightning_logs/
mlruns/
